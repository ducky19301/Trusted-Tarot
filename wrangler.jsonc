// Cloudflare Workers "static assets" config (free plan). Cloudflare Pages ignores this file; both use public/ as is.
{
  "name": "trusted-tarot",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "previews": {}
}
